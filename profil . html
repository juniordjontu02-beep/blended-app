<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Mon Profil - Blended</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box;margin:0;font-family:Arial}
body{background:#000;color:#fff;text-align:center;padding:20px}
.top{max-width:400px;margin:0 auto}
a.back{color:#888;float:left;text-decoration:none;font-size:16px;margin-bottom:20px}
h2{margin:40px 0 20px}
#prev{width:130px;height:130px;border-radius:50%;object-fit:cover;border:4px solid #00e676;margin:10px}
.card{background:#111;padding:20px;border-radius:16px;margin-top:20px;border:1px solid #222}
input{padding:14px;border-radius:12px;width:100%;background:#222;border:none;color:#fff;margin:10px 0;font-size:16px}
button{background:#00e676;border:none;padding:14px 30px;border-radius:25px;font-weight:bold;width:100%;font-size:16px;color:#000;cursor:pointer;margin-top:10px}
#msg{margin-top:15px;color:#00e676;font-weight:bold}
</style>
</head>
<body>
<div class="top">
<a class="back" href="index.html">← Retour</a>
<h2>Mon Profil</h2>
<img id="prev" src="https://i.pravatar.cc/200">
<div class="card">
<p style="color:#888;font-size:14px">Clique pour changer ta photo</p>
<input type="file" id="file" accept="image/*">
<input id="name" type="text" placeholder="Ton nom">
<input id="email" type="text" disabled style="opacity:0.5">
<button onclick="save()">💾 Enregistrer ma photo</button>
<p id="msg"></p>
</div>
</div>

<script>
const supa=supabase.createClient('https://zdfxuhjobcbfzymejkcm.supabase.co','sb_publishable_KPfVjYwPXE12BZKkjYDkAQ_QRjDEZRy');
let cur=JSON.parse(localStorage.getItem('blended_cur'));
if(!cur) location.href='inscription.html';

document.getElementById('prev').src=cur.av||'https://i.pravatar.cc/200';
document.getElementById('name').value=cur.n;
document.getElementById('email').value=cur.e;

let b64='';
document.getElementById('file').onchange=e=>{
  let r=new FileReader();
  r.onload=()=>{b64=r.result; document.getElementById('prev').src=b64};
  r.readAsDataURL(e.target.files[0]);
};

async function save(){
  let msg=document.getElementById('msg');
  msg.innerText='⏳ Enregistrement...';
  let av=b64||cur.av;
  let n=document.getElementById('name').value.trim();
  if(!n){msg.innerText='❌ Mets un nom'; return;}
  let {error}=await supa.from('users').update({n:n, av:av}).eq('e',cur.e);
  if(error){msg.innerText='❌ '+error.message; return;}
  cur.n=n; cur.av=av;
  localStorage.setItem('blended_cur',JSON.stringify(cur));
  msg.innerText='✅ Photo changée avec succès!';
  setTimeout(()=>location.href='index.html',1200);
}
</script>
</body>
</html>
